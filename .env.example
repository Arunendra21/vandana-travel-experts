# ─── Vandana Travel Experts — environment variables ───────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. This file lists names only.

# 1) DATABASE — created automatically when you add "Vercel Postgres" (Storage tab).
#    Vercel injects POSTGRES_URL (and related POSTGRES_* vars) for you.
# POSTGRES_URL=

# 2) IMAGE STORAGE — created automatically when you add "Vercel Blob" (Storage tab).
# BLOB_READ_WRITE_TOKEN=

# 3) ADMIN AUTH — you must set these:
AUTH_SECRET=              # long random string (e.g. `openssl rand -hex 32`)
SETUP_TOKEN=              # random string; protects the one-time /api/admin/setup route
ADMIN_INITIAL_EMAIL=      # first admin's email (e.g. manish@travelvandana.com)
ADMIN_INITIAL_PASSWORD=   # TEMPORARY password (8+ chars); you must change it on first login

# 4) EMAIL (optional) — where customer enquiries are emailed.
#    Defaults to vandanatravelexperts@gmail.com if unset.
# TEAM_EMAIL=

# 5) LIVE FLIGHTS (optional) — for real flight status:
AERODATABOX_KEY=          # RapidAPI key for AeroDataBox (recommended)
# AVIATIONSTACK_KEY=      # alternative provider (fallback)
